// On the field (plan docs/plans/m2-train-sol.md): the SPAD at rest on its wheels and skid,
// engine at idle, at the west end of the meadow, facing east along it. The state is the
// flight model's own, computed by fdm_lab; the test `the_field_start_is_the_aircraft_at_rest`
// of fdm_lab fails when the flight model no longer rests there, with the values to copy.
Scenario(
    aircraft: "spad7",
    fuel_fraction: 1.0,                  // C: full tanks, the loading of the flight tests
    heading: Deg(90.0),                  // C: east, as the test flight
    position_m: (0.0, -340.0),           // E: 60 m from the west end of a meadow of 800 m across the origin (plan, decision 2)
    start: Ground((
        height: M(1.2898),               // C: fdm_lab, rest on the undercarriage
        pitch: Rad(0.26259),             // C: fdm_lab, rest on the undercarriage
        rotor_speed: RadS(52.02),        // C: fdm_lab, idle at a standstill
        elevator: -0.071,                // C: fdm_lab, stick of the best climb at sea level
    )),
)
