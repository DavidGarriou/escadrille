// Test flight, first playable increment of M2 (docs/plans/m2-vol-essai.md): the SPAD in
// steady level flight, over the origin of the map. The equilibrium is the flight
// model's, solved by fdm_lab (`fdm_lab trim spad7 --speed-kmh 160 --altitude-m 1000`,
// still air, full tanks); the test `the_test_flight_starts_in_equilibrium` of fdm_lab
// fails when the flight model no longer holds it, with the values to copy here.
Scenario(
    aircraft: "spad7",
    fuel_fraction: 1.0,      // C: full tanks, the loading of the flight tests
    heading: Deg(90.0),      // C: east, the player's choice (2026-10-28)
    start: Flight(
    altitude: M(1000.0),     // C: the player's choice (2026-10-28)
    speed: Kmh(160.0),       // C: the player's choice (2026-10-28)
    equilibrium: (
        //! C: fdm_lab trim of 2026-10-31 (level flight at the scenario's speed and altitude), after the centre of gravity and the two tables (spad7-calculs.md § 4.1)
        alpha: Rad(0.002935419),
        beta: Rad(0.010727963),
        roll: 0.003004055,
        pitch: -0.094663640,
        yaw: 0.006399405,
        throttle: 0.544743846,
        rotor_speed: RadS(154.655060302),
        downwash: Rad(0.043962871),
    ),
    ),
)
