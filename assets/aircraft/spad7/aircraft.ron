// SPAD S.VII C.1 with the Hispano-Suiza 8Aa of 150 ch (player's decision of 2026-10-22).
// Research: docs/recherche/spad7.md, hispano-suiza-8a.md, profil-spad7.md. Every C: and E:
// value is justified in docs/recherche/spad7-calculs.md; the aerodynamic estimates
// (drag, fuselage, downwash, efficiencies, propeller) are the aerodynamicist's of
// 2026-10-22, computed on the geometry of the 1917 drawing (spad7-calculs.md § 3).
Aircraft(
    id: "spad7",
    name: "SPAD S.VII C.1 (Hispano-Suiza 8Aa, 150 ch)",
    research: "docs/recherche/spad7.md",
    datum: "bord d'attaque du plan inférieur, dans l'axe de l'avion (point virtuel)",
    dimensions: Some((
        span: M(7.82),                                                         // S: spad7.md § 2.1, A: 25.7 and 25.8 ft (7.83 and 7.86 m) in the two period tables (S46, S47); 7.82 m (S7, S8)
        length: M(6.08),                                                       // S: spad7.md § 2.1, B: 6.08 m (S6, S7, S8); 20 ft = 6.10 m (S46, S47)
        height: M(2.20),                                                       // S: spad7.md § 2.1, A: 7.20 ft = 2.19 m (S46), 2.20 m (S6); attitude of measurement not given
    )),

    mass: (
        empty: Lb(1100.0),                                            // S: S46 p. 205, both 7C1 lines, and S47 p. 237 (spad7.md § 3)
        cg_empty_m: (-0.313, 0.0, -0.459),                            // C: fdm_lab inertia spad7 (masses.ron)
        inertia_empty_kg_m2: (ixx: 784.0, iyy: 778.0, izz: 1359.0, ixz: 24.0), // C: fdm_lab inertia spad7 (masses.ron)
        pilot: Lb(176.0),                                             // S: S46 crew load (p. 204-205)
        pilot_m: (-1.15, 0.0, -0.37),                                 // C: seat behind the cockpit opening of the drawing, about 0.45 m above the floor
        fuel: (capacity: L(135.0), density_kg_per_l: 0.72, position_m: (-0.95, 0.0, -0.15)), // C: 135 L in all (S13, seen in summary); E: density; main tank under the seat (S13)
        payload: [
            (name: "armement (Vickers et munitions)", mass: Lb(88.0), position_m: (-0.10, 0.0, -0.75)), // S: S46 armament load; E: gun on the cowling, ammunition box behind the engine
            (name: "huile", mass: Kg(8.0), position_m: (0.15, 0.0, -0.20)),                            // E: about 2 h at 2.8 L/h (H20) plus the circuit, inside the 176 lb of petrol and oil of S46
            (name: "divers", mass: Lb(11.0), position_m: (-1.0, 0.0, -0.5)),                           // S: S46 sundries; E: position near the cockpit
        ],
    ),

    surfaces: [
        (
            name: "upper_wing",
            kind: Horizontal,
            mirrored: true,
            panels: [(
                root_m: (-0.3025, 0.0, -1.27), tip_m: (-0.3025, 3.91, -1.27), // C: quarter chord of the 1.21 m chord, no stagger (vertical struts on the 1917 drawing); S: span 7.82 m (spad7.md § 2.1), gap 4 ft 2 in (S48)
                chord_root: M(1.21), chord_tip: M(1.21),                       // C: published area (A) over the gross rectangle, ratio 0.94 of the SPAD family (spad7-calculs.md § 3)
                incidence: Deg(2.3),                                           // C: fuselage level at 170 km/h and 2 000 m (aerodynamicist's criterion), decalage +0.5° of the XIII (S15)
                strips: 16,                                                    // C: convergence in the slipstream: doubling again moves the swirl left behind the wings by less than 0.02 and the trimmed roll and yaw commands by less than 0.005 (fdm_lab test the_swirl_left_converges_with_the_strips; aerodynamicist review of 2026-10-25: 8 per half-wing left 1.5 to 2 strips per half-jet)
            )],
            airfoil: "airfoils/spad.ron",
            span_efficiency: 0.92,                                             // C: 1/(1 + δ) = 0.952 (TR 416) × 0.979 fuselage gap × 0.985 cut-out and rounded tips
            controls: [
                (control: Aileron, span_from: 0.5, span_to: 1.0, chord_ratio: 0.29), // C: upper plane only, 1.95 m from the tip and 29 % of the chord on the 1917 drawing at line centres (0.41 m of a drawn 1.41 m chord; 27 to 31 % with the line edges; aerodynamicist 2026-10-26, spad7-calculs.md § 3.1); the ratio is kept on the 1.21 m chord of the data, the drawing's chord being that of S48 (S48: upper plane)
            ],
        ),
        (
            name: "lower_wing",
            kind: Horizontal,
            mirrored: true,
            panels: [(
                root_m: (-0.3025, 0.40, 0.0), tip_m: (-0.3025, 3.91, 0.0),    // C: from the side of the fuselage (0.80 m wide) to the tip; equal spans (S48, S16)
                chord_root: M(1.21), chord_tip: M(1.21),                       // C: as the upper plane
                incidence: Deg(1.8),                                           // C: fuselage level at 170 km/h and 2 000 m
                strips: 16,                                                    // C: convergence in the slipstream: doubling again moves the swirl left behind the wings by less than 0.02 and the trimmed roll and yaw commands by less than 0.005 (fdm_lab test the_swirl_left_converges_with_the_strips; aerodynamicist review of 2026-10-25: 8 per half-wing left 1.5 to 2 strips per half-jet)
            )],
            airfoil: "airfoils/spad.ron",
            span_efficiency: 0.92,                                             // C: as the upper plane
        ),
        (
            name: "tailplane",
            kind: Horizontal,
            mirrored: true,
            panels: [(
                root_m: (-4.26, 0.0, -0.70), tip_m: (-4.26, 1.405, -0.70),    // C: unswept quarter chord at the mean aerodynamic chord (the loader widens swept strips); span 2.81 m and height on the drawing
                chord_root: M(1.14), chord_tip: M(0.50),                       // C: drawing, area kept
                incidence: Deg(0.0),                                           // C: horizontal on the drawing; S.XI tailplane at 0° (S49)
                strips: 6,                                                     // C: convergence in the slipstream: doubling again moves the swirl left behind the wings by less than 0.02 and the trimmed roll and yaw commands by less than 0.005 (fdm_lab test the_swirl_left_converges_with_the_strips; aerodynamicist review of 2026-10-25: 8 per half-wing left 1.5 to 2 strips per half-jet)
            )],
            airfoil: "airfoils/spad_empennage.ron",
            span_efficiency: 0.80,                                             // C: Helmbold lift slope at aspect ratio 3.4 reproduced by the lifting line
            controls: [
                (control: Elevator, span_from: 0.0, span_to: 1.0, chord_ratio: 0.44, hinge_m: Some(((-4.51, 0.0, -0.70), (-4.51, 1.405, -0.70)))), // C: elevator 1.00 of 2.30 m² on the drawing; hinge (3D model only) read on the top view of the 1917 drawing (S48, 240.7 px/m, aerodynamicist 2026-10-26): straight across both halves, square to the axis within 0.3°, x −4.51 ± 0.03 m (spad7-calculs.md § 3.1)
            ],
            reference_area: Some(M2(2.30)),                                    // C: digitised outline of the drawing
        ),
        (
            name: "fin",
            kind: Vertical,
            mirrored: false,
            panels: [
                (
                    root_m: (-4.631, 0.0, -0.31), tip_m: (-4.631, 0.0, -0.5), // C: band z −0.31 to −0.50 of the vertical tail on the 1917 drawing (side view at line centres, S48, 240 px/m, aerodynamicist 2026-10-26; spad7-calculs.md § 3.1): sternpost to the rounded lower corner of the rudder, 0.112 m²; unswept, at the band's area-weighted quarter chord (plan m3-modele-spad7.md, part A)
                    chord_root: M(0.346), chord_tip: M(0.838),                     // C: the band's drawn area and the height of its centroid, kept by the taper
                    incidence: Deg(0.0),                                         // E: no offset
                    strips: 2,                                                   // C: about 0.1 m per strip; convergence in the slipstream checked on 2026-10-26 with the five panels: doubling every strip moves the trimmed rudder by 0.0015 of its travel at best climb and 0.0070 at the full-throttle stall, hub at z −0.40 (0.0040 and 0.0055 with the hub at −0.38) (limits 0.005 and 0.01, fdm_lab test the_swirl_left_converges_with_the_strips); the top panel keeps 2 strips (with 3 its first strip puts the 3D model's length out of tolerance)
                ),
                (
                    root_m: (-4.663, 0.0, -0.5), tip_m: (-4.663, 0.0, -0.7), // C: band z −0.50 to −0.70 (same origin and method): sternpost to the straight trailing edge of the rudder, 0.155 m²; unswept, at the band's area-weighted quarter chord (plan m3-modele-spad7.md, part A)
                    chord_root: M(0.759), chord_tip: M(0.795),                     // C: the band's drawn area and the height of its centroid, kept by the taper
                    incidence: Deg(0.0),                                         // E: no offset
                    strips: 2,                                                   // C: about 0.1 m per strip; convergence in the slipstream checked on 2026-10-26 with the five panels: doubling every strip moves the trimmed rudder by 0.0015 of its travel at best climb and 0.0070 at the full-throttle stall, hub at z −0.40 (0.0040 and 0.0055 with the hub at −0.38) (limits 0.005 and 0.01, fdm_lab test the_swirl_left_converges_with_the_strips); the top panel keeps 2 strips (with 3 its first strip puts the 3D model's length out of tolerance)
                ),
                (
                    root_m: (-4.076, 0.0, -0.7), tip_m: (-4.076, 0.0, -0.92), // C: band z −0.70 to −0.92 (same origin and method): root of the fin on the fuselage and rudder, 0.342 m²; unswept, at the band's area-weighted quarter chord (plan m3-modele-spad7.md, part A)
                    chord_root: M(1.684), chord_tip: M(1.424),                     // C: the band's drawn area and the height of its centroid, kept by the taper
                    incidence: Deg(0.0),                                         // E: no offset
                    strips: 2,                                                   // C: about 0.1 m per strip; convergence in the slipstream checked on 2026-10-26 with the five panels: doubling every strip moves the trimmed rudder by 0.0015 of its travel at best climb and 0.0070 at the full-throttle stall, hub at z −0.40 (0.0040 and 0.0055 with the hub at −0.38) (limits 0.005 and 0.01, fdm_lab test the_swirl_left_converges_with_the_strips); the top panel keeps 2 strips (with 3 its first strip puts the 3D model's length out of tolerance)
                ),
                (
                    root_m: (-4.391, 0.0, -0.92), tip_m: (-4.391, 0.0, -1.14), // C: band z −0.92 to −1.14 (same origin and method), 0.247 m²; unswept, at the band's area-weighted quarter chord (plan m3-modele-spad7.md, part A)
                    chord_root: M(1.353), chord_tip: M(0.891),                     // C: the band's drawn area and the height of its centroid, kept by the taper
                    incidence: Deg(0.0),                                         // E: no offset
                    strips: 2,                                                   // C: about 0.1 m per strip; convergence in the slipstream checked on 2026-10-26 with the five panels: doubling every strip moves the trimmed rudder by 0.0015 of its travel at best climb and 0.0070 at the full-throttle stall, hub at z −0.40 (0.0040 and 0.0055 with the hub at −0.38) (limits 0.005 and 0.01, fdm_lab test the_swirl_left_converges_with_the_strips); the top panel keeps 2 strips (with 3 its first strip puts the 3D model's length out of tolerance)
                ),
                (
                    root_m: (-4.757, 0.0, -1.14), tip_m: (-4.757, 0.0, -1.4), // C: band z −1.14 to −1.40 (same origin and method): top of the fin and rounded top of the rudder, 0.143 m²; unswept, at the band's area-weighted quarter chord (plan m3-modele-spad7.md, part A)
                    chord_root: M(0.94), chord_tip: M(0.157),                     // C: the band's drawn area and the height of its centroid, kept by the taper
                    incidence: Deg(0.0),                                         // E: no offset
                    strips: 2,                                                   // C: about 0.1 m per strip; convergence in the slipstream checked on 2026-10-26 with the five panels: doubling every strip moves the trimmed rudder by 0.0015 of its travel at best climb and 0.0070 at the full-throttle stall, hub at z −0.40 (0.0040 and 0.0055 with the hub at −0.38) (limits 0.005 and 0.01, fdm_lab test the_swirl_left_converges_with_the_strips); the top panel keeps 2 strips (with 3 its first strip puts the 3D model's length out of tolerance)
                ),
            ],
            airfoil: "airfoils/spad_empennage.ron",
            span_efficiency: 0.61,                                             // C: reproduces the DATCOM and Helmbold slope of 1.77 per radian at aspect ratio 1.36 (half-chord sweep of the real outline 39°, area-weighted: 45.5° above the tailplane, 21° below; section slope 5.57). Below the tailplane the two panels are in the fuselage's wake (η_v about 0.8 to 0.9, DATCOM order of magnitude); no factor (player's decision of 2026-10-26, plan m1-derive-spad7.md, option a): its side force is 10 to 20 % too high, 4.5 to 9 N·m/(m/s) of N_v (4 to 8 %; they carry 46.5 N·m/(m/s) of it, measured with the hub at z −0.38), of which under 1 for the fixed part added; not compensated here
            aspect_ratio: Some(1.36),                                          // E: geometric 1.19 (span 1.09 m, 1.00 m²) with the partial end plate of tailplane and fuselage of the first estimate, × 1.145 (Hemke, TR 267); range 1.2 to 1.5
            controls: [
                (control: Rudder, panel: 0, span_from: 0.0, span_to: 1.0, chord_ratio: 0.61, hinge_m: Some(((-4.70, 0.0, -0.31), (-4.70, 0.0, -0.5)))), // C: drawn rudder 0.068 of the band's 0.112 m²; strips' hinge at x −4.714; hinge (3D model only): rudder post on the side view of the 1917 drawing (S48, 240 px/m, aerodynamicist 2026-10-26), vertical within 0.2°, x −4.70 ± 0.03 m, 0.23 m (8.9 in) behind the sternpost at x −4.47 (« about 10 ins. », S48) (spad7-calculs.md § 3.1)
                (control: Rudder, panel: 1, span_from: 0.0, span_to: 1.0, chord_ratio: 0.71, hinge_m: Some(((-4.70, 0.0, -0.5), (-4.70, 0.0, -0.7)))), // C: drawn rudder 0.110 of 0.155 m²; strips' hinge at x −4.694; hinge (3D model only): the same post
                (control: Rudder, panel: 2, span_from: 0.0, span_to: 1.0, chord_ratio: 0.35, hinge_m: Some(((-4.70, 0.0, -0.7), (-4.70, 0.0, -0.92)))), // C: drawn rudder 0.121 of 0.342 m²; strips' hinge at x −4.698; hinge (3D model only): the same post
                (control: Rudder, panel: 3, span_from: 0.0, span_to: 1.0, chord_ratio: 0.49, hinge_m: Some(((-4.70, 0.0, -0.92), (-4.70, 0.0, -1.14)))), // C: drawn rudder 0.120 of 0.247 m²; strips' hinge at x −4.683; hinge (3D model only): the same post
                (control: Rudder, panel: 4, span_from: 0.0, span_to: 1.0, chord_ratio: 0.82, hinge_m: Some(((-4.70, 0.0, -1.14), (-4.70, 0.0, -1.29)))), // C: drawn rudder 0.117 of 0.143 m², rounded top included; strips' hinge at x −4.719; hinge (3D model only): the post, up to where the fin's leading edge meets it (z −1.29), the rounded top being all behind it; rudder in all 0.536 m², as drawn
            ],
            reference_area: Some(M2(1.00)),                                    // C: whole vertical tail on the 1917 drawing at line centres: fin 0.37 m² above the tailplane, fixed part 0.09 below it, rudder 0.54 (spad7-calculs.md § 3.1)
        ),
    ],
    interference: [(planes: ("upper_wing", "lower_wing"), sigma: 0.54)],      // C: Prandtl, NACA TN 182 table I, gap / span 0.162 (spad7.md § 2.4)
    downwash: Some((
        wings: ["upper_wing", "lower_wing"],
        tail: ["tailplane"],
        factor: 0.125,                                                         // C: two flat vortex sheets in the Trefftz plane, 2S/(πb²) = 0.187 × 0.84 (tail at mid-gap) × 0.86 (near wake) × 0.915 (DATCOM); equivalent monoplane 0.122
        tail_arm: M(3.96),                                                     // C: wing quarter chord (x −0.30) to the tailplane mean-chord quarter chord (x −4.26)
        // The swirl the wings leave behind them follows from the angular momentum they take from it (FDM, plan docs/plans/m1-rotation-derriere-ailes.md)
    )),

    // Element by element (Hoerner); no 3/5 interference factor (S43 had no propeller; the
    // drag of the B.E.2c parts added up, Relf and Lavender 1917). Round stranded wires: no
    // source shows streamlined wires on the S.VII. Check: equivalent f of 0.91 m² in level
    // flight at 2 000 m, profiles included, against 0.94 to 0.98 m² from S46 (not tuned).
    parasite_drag: [
        (name: "radiateur frontal", cd: 0.45, reference_area: M2(0.396), position_m: (0.62, 0.0, -0.40)),               // E: internal flow (radiator and cowl losses, exit about half the opening) 0.30-0.35 plus nose and louvres; C: circular opening 0.71 m (drawing)
        (name: "fuselage (frottement)", cd: 0.0047, reference_area: M2(13.5), position_m: (-1.50, 0.0, -0.47)),         // C: Schlichting turbulent Cf at Re 1.7e7 × Hoerner form factor 1.20 × 1.25 (E: fabric, stringers, louvres) plus the tail post; wetted area of the drawing stations (the fixed part of the fin behind the sternpost, added on 2026-10-26, is counted by the fin's strips: any overlap is under 0.001 m², 0.1 % of f)
        (name: "poste, tête du pilote et pare-brise", cd: 0.45, reference_area: M2(0.10), position_m: (-1.15, 0.0, -1.08)), // E: helmeted head 0.045 m², 60 % sheltered, windscreen and cavity
        (name: "Vickers", cd: 0.75, reference_area: M2(0.020), position_m: (-0.05, 0.0, -1.02)),                       // E: frontal area of box, jacket and sight
        (name: "échappements et bossages", cd: 1.0, reference_area: M2(0.015), position_m: (-0.60, 0.0, -0.49)),      // E: two pipes 1.6 m × 0.06 m seen in profile, plus bulges
        (name: "cabane", cd: 1.0, reference_area: M2(0.010), position_m: (-0.40, 0.0, -1.12)),                        // E: 4 struts of 0.43 m (front view), fittings and bracing
        (name: "train", cd: 1.0, reference_area: M2(0.047), position_m: (0.0, 0.0, 0.45)),                            // C: 4 streamlined legs, faired axle as on the S.XI, rubber cord and guides, +10 % interference
        (name: "roue droite", cd: 0.30, reference_area: M2(0.060), position_m: (0.12, 0.76, 0.78)),                  // E: 700 × 75 wheel with covered spokes, plus hub; S: track 5 ft (S48)
        (name: "roue gauche", cd: 0.30, reference_area: M2(0.060), position_m: (0.12, -0.76, 0.78)),                 // E: as the right wheel
        (name: "béquille", cd: 1.0, reference_area: M2(0.006), position_m: (-4.30, 0.0, -0.10)),                      // E:
        (name: "haubans et guignols d'empennage", cd: 1.0, reference_area: M2(0.015), position_m: (-4.40, 0.0, -0.65)), // E: 4 bracing wires of 0.8 m, horns, cables
        (name: "mâts extérieurs droits", cd: 0.133, reference_area: M2(0.084), position_m: (-0.40, 3.00, -0.635)),     // C: 2 struts 0.035 × 1.20 m, streamlined fineness 3 (cd 0.11 at Re 3e5), fittings; y read on the front view
        (name: "mâts extérieurs gauches", cd: 0.133, reference_area: M2(0.084), position_m: (-0.40, -3.00, -0.635)),   // C: as the right struts
        (name: "mâts intermédiaires droits", cd: 0.177, reference_area: M2(0.060), position_m: (-0.40, 1.70, -0.635)), // C: 0.025 m thick (E:), same method, plus the collar where the wires cross
        (name: "mâts intermédiaires gauches", cd: 0.177, reference_area: M2(0.060), position_m: (-0.40, -1.70, -0.635)), // C: as the right struts
        (name: "renvois d'ailerons droits", cd: 1.15, reference_area: M2(0.021), position_m: (-0.75, 3.00, -0.635)),   // E: round rod 15 mm × 1.25 m, bellcrank and horn (S48: outside linkage)
        (name: "renvois d'ailerons gauches", cd: 1.15, reference_area: M2(0.021), position_m: (-0.75, -3.00, -0.635)), // E: as the right linkage
        (name: "câbles intérieurs droits", cd: 1.03, reference_area: M2(0.0216), position_m: (-0.40, 0.75, -0.65)),    // C: 8 flying wires 4.5 mm doubled in tandem, 4 landing 3.5 mm, 4 incidence 3 mm; cd 1.2 stranded at Re 1e4, +12 % turnbuckles; 27 % of the length within 1.2 m of the axis (in the slipstream)
        (name: "câbles intérieurs gauches", cd: 1.03, reference_area: M2(0.0216), position_m: (-0.40, -0.75, -0.65)),  // C: as the right inner wires
        (name: "câbles extérieurs droits", cd: 1.03, reference_area: M2(0.0583), position_m: (-0.40, 2.05, -0.65)),    // C: the other 73 % of the wire length
        (name: "câbles extérieurs gauches", cd: 1.03, reference_area: M2(0.0583), position_m: (-0.40, -2.05, -0.65)),  // C: as the right outer wires
    ],

    fuselage: Some((
        position_m: (-1.55, 0.0, -0.47),                                       // C: centroid of the side (x −1.59) and plan (x −1.48) areas, fuselage axis
        volume_m3: 0.95,                                                       // C: Multhopp (DATCOM): π/4 w² weighted by the upwash ahead of the wings, nil across them, (x/l_h)(1 − dε/dα) behind: k Vol = 0.79 m³ divided by k₂ − k₁
        apparent_mass: 0.83,                                                   // C: Lamb, ellipsoid of fineness 4.87 (length 5.14 m on the drawing)
        plan_area: M2(3.30), side_area: M2(4.50),                              // C: drawing, minus the part under the tailplane (plan) and without the tail (side)
        crossflow_drag: 0.75,                                                  // E: η 0.61 (Allen and Perkins, fineness 4.9) × C_dc 1.2 (rounded rectangular section)
    )),

    engine: Inline((
        name: "Hispano-Suiza 8Aa",
        power_curve: [
            //! C: shape of NACA Report 46 (180 hp Hispano, table 1, sea level, full throttle; hispano-suiza-8a.md § 3.1) scaled to the 175 hp at 1 700 rpm « maximum power permitted » of the 8Aa (S46); 1 300 rpm from mechanical efficiency × indicated power
            (speed: Rpm(1300.0), power: Hp(130.2)),
            (speed: Rpm(1500.0), power: Hp(154.3)),
            (speed: Rpm(1700.0), power: Hp(175.0)),
            (speed: Rpm(1900.0), power: Hp(185.3)),
            (speed: Rpm(2100.0), power: Hp(196.6)),
        ],
        friction: Curve([
            //! C: friction power of NACA Report 46 (same bore, stroke and family), about constant with altitude
            (speed: Rpm(1300.0), power: Hp(13.1)),
            (speed: Rpm(1500.0), power: Hp(14.7)),
            (speed: Rpm(1700.0), power: Hp(16.0)),
            (speed: Rpm(1900.0), power: Hp(20.0)),
            (speed: Rpm(2100.0), power: Hp(25.0)),
        ]),
        altitude_law: Pressure(0.93),                                          // C: R&M 462 flight measurement on a 150 hp Hispano, brake power in (p/p₀)^1.04, converted to the indicated power with the friction above (±0.6 % from 1 000 to 5 000 m)
        installed_power: 0.973,                                                // C: NACA Report 301 p. 10 (VE-7, Wright-Hispano): flight C_P 3 to 5 % above the full-scale tunnel's in three tests of four (midpoint 4 %), less the 1 % that the p/√T reduction of its flight references (Reports 220 and 292, 1 500 to 3 000 ft) puts above this engine's altitude law: −3 % of brake power, 1 − 0.03 × 175 / 191 of the indicated power; range 0 to 4 %, cause not identified by the source (spad7-calculs.md § 7)
        temperature_exponent: Some(0.4),                                       // C: indicated power as (T_std / T)^m at constant pressure, m from 0.27 to 0.46: NACA Report 220 p. 7, brake power of a Wright-Hispano « closely as 1/√T » on the dynamometer (0.46 on the indicated power); L.C.E. 196 cited by R&M 462, −5 to −7 % for +19 % of absolute temperature (0.27 to 0.38); 0.37 for the exponent 0.93 to hold a charge in p at fixed temperature; R&M 462 finds no sensible effect in flight (aerodynamicist review of 2026-10-24)
        idle_throttle: 0.045,                                                  // C: about 500 rpm at a standstill on the ground with the propeller's C_P(0) (E: idling 450 to 500 rpm)
        stall_speed: Rpm(200.0),                                               // E: magneto ignition, full firing from 400 rpm
    )),

    propeller: (
        table: "aircraft/spad7/propeller.ron",
        diameter: M(2.40),                                                     // C: Éclair type 6, 2.40 × 1.95 m (P/D 0.81, that of the D' table), « approuvé » for the SPAD VII with the 150 ch; Hartmann names Éclair (types 6 and 100) as the main propeller of the S.VII (hispano-suiza-8a.md § 7.5.10); player's choice of 2026-10-24, Levasseur 485 (2.45 m) and Éclair 100 kept as variants (spad7-calculs.md § 7)
        hub_m: (0.78, 0.0, -0.40),                                             // C: 1917 drawing (S48), side view at line centres (aerodynamicist 2026-10-26): blade mid-chord plane x 0.79, boss centre x 0.76, blade front face x 0.84; hub 0.405 ± 0.01 m above the lower leading edge (blade tips and boss, checked on the upper plane and the tailplane); drawn diameter 2.30 m
        rotation: Clockwise,                                                   // S: clockwise seen by the pilot, confidence B: « R H Tractor S7 » on the British S.VII propeller AB 723, « right hand » being clockwise seen by the pilot in British usage of 1917-18 (spad7.md § 6.5.3), and five concordant clues (hispano-suiza-8a.md § 7.3)
        p_factor_m: 1.08,                                                      // C: blade elements on the D' geometry (Report 301, fig. 5): 1.16 to 1.68 m with frozen inflow at the climbing J, × 0.75 for the induced-velocity feedback, scaled with the diameter from 2.45 to 2.40 m (1.1 × 0.98)
        normal_force: 0.038,                                                   // C: blade elements, c_n 0.034 to 0.038 for J 0.6 to 0.76, × 1.1 for the upwash ahead of the wings
        rotor_inertia_kg_m2: 6.7,                                              // C: wooden propeller of 22 kg (E:), m R² / 5 = 6.3 at 2.40 m, plus 0.3 to 0.6 of crankshaft
    ),

    travel: (aileron: Deg(20.0), elevator: Deg(25.0), rudder: Deg(30.0)),      // E: usual period throws, no SPAD source (the XIII manual, S38, still to be found)
)
