    wheels: (
        centre_m: (0.136, 0.77, 0.764),                              // C: 1917 drawing, side and front views at line centres (aerodynamicist 2026-10-26, table T6): track 1.54 m, the 5 ft of S48
        diameter: Mm(610.0),                                         // C: tyre 0.608 m at line centre, rim 0.484 m (T6); the 700 mm of the S.XI drawing (S49) is not the S.VII's
        width: Mm(75.0),                                             // E: as the « 700 × 7… » of the S.XI (S49)
    ),
    skid_m: (-4.38, 0.0, -0.09),                                     // C: shoe of the tail skid on the 1917 drawing (T6): about 14° tail down on the ground
    struts: [
        (x_m: -0.41, y_m: 3.03),                                     // C: outer interplane struts on the 1917 drawing (T5): front and rear at x −0.172 and −0.651, y from the front view recentred
        (x_m: -0.41, y_m: 1.71),                                     // C: intermediate struts (T5), same x
    ],
    pilot_eye_m: (-1.05, 0.0, -1.10),                                // E: 0.10 m ahead of the head's centre (drag item of aircraft.ron)
    gun_muzzles_m: [
        (0.35, 0.0, -1.03),                                          // E: Vickers on top of the cowl (top at z −0.97 on the 1917 drawing, table T1), jacket of 0.11 m; C: x of the small boss at x 0.33 to 0.37 that may be its muzzle (T3b, T7: possibly the radiator cap, D); y not readable (T7)
    ],
    accepted_deviations: [
        //! Checks of `just test` (tools/asset_check) that this model fails, accepted by the player on 2026-10-26 (carnet); the length one was dropped the same day, the vertical tail of aircraft.ron now following the drawing (6.099 m); the model in the assets is the Blender one since that day
        (
            check: "height",
            measured: M(2.271),                                      // C: the Blender model at rest on its wheels and skid shoe as drawn (art/spad7/build.py); 2.464 m in the flying attitude. Before the drawing's undercarriage was read (wheels 0.61 m, skid shoe at z −0.09): 2.343 m for this model, 2.355 m for the box model
            reason: "2.20 m cannot be the flying attitude, and at rest the drawing's undercarriage stands 2.27 m before its tyres and rubber cords settle under the weight (not modelled): drawing and tables disagree by 3 %",
        ),                                                           // C: in flight, the fin top (z −1.40) and the propeller tip (z 0.80) alone span 2.20 m; at rest 2.271 m with the drawing's 0.61 m wheels and skid, the upper leading edge highest; 3 to 6 cm of static compression would give 2.21 to 2.24 m (aerodynamicist's review, 2026-10-25); spad7.md § 2.1 (2.12 to 2.35 m in the sources, attitude not given)
    ],
    outlines: [
        (
