    features: [
        (name: "radiator", rows: [[0.660, -0.430, 0.670]]),                                    // C: x of its face, z of its centre, diameter of the circular opening at line centre (1917 drawing (Flight, 16 Aug 1917, p. 841; S48), at line centres, 240 px/m, ±0.015 m (aerodynamicist 2026-10-26, T3a): 0.71 m at the first reading was the outer edge
        (name: "cowl_ring", rows: [[0.490, 0.660]]),                                           // C: x of the front ring of the cowl, from its joint to the radiator face, rounded lip (T3a, T3b)
        (name: "camshaft_bulges", rows: [[0.300, -0.870, 0.180, -0.100, 0.450]]),                    // C: y, z and diameter of the camshaft covers on the cowl shoulders, front view (T3a); E: their x span, that of the top panel's joint (T3a), their length not being drawn
        (name: "exhaust_stubs", rows: [[-0.170, -0.640], [-0.040, -0.610], [0.120, -0.610], [0.250, -0.605]]), // C: x and z of the top of each stub, a bank of four cylinders (T3d)
        (name: "exhaust_collector", rows: [[0.560, -0.200, 0.380, 0.480, -0.690]]),                  // C: y of the collector (top view, 3 cm off the cowl), its x from (E: behind the first stub) and the x and z of its front crook (T3d)
        (name: "exhaust_pipe", rows: [[-0.490, 0.050, 0.480, -1.670]]),                            // C: z and diameter of the pipe along the flank, x of its front (the collector's outlet) and of its end, 0.22 m behind the cockpit's rear rim (T3d)
        (name: "upper_wing_cutout", rows: [
        //! C: half-width of the cut-out in the upper plane over the cockpit and the chord fraction its edge reaches, from the leading edge, on the drawn chord of 1.41 m (T4); the fractions are kept on the 1.21 m chord of the data
            [0.800, 0.993], [0.620, 0.957], [0.585, 0.922], [0.567, 0.887], [0.548, 0.851], [0.519, 0.816], [0.478, 0.780], [0.460, 0.745], [0.400, 0.709], [0.355, 0.674], [0.260, 0.638], [0.000, 0.603],
        ]),
        (name: "wing_tip_radius", rows: [[0.163]]),                                         // C: fillet of 0.19 m at the four corners of the drawn planform (T4, standard deviation 3 mm), on the drawn chord of 1.41 m, scaled to 1.21 m
        (name: "strut_spars", rows: [[0.120, 0.460]]),                                           // C: front and rear interplane and cabane struts at 12 and 46 % of the drawn chord from the leading edge (T5; 17 and 49 % at the first reading, line edges)
        (name: "cabane", rows: [[0.410, -0.770]]),                                               // C: y and z of the feet of the vertical cabane struts on the cowl, front view (T5); x at the strut spars, hidden in the side view
        (name: "steel_tube", rows: [[-0.620, -0.220, -0.650]]),                                    // C: x from, x to and z of the steel tube between the intermediate struts, at mid-gap (T5, S48)
        (name: "gear_front_leg", rows: [[0.128, 0.415, 0.000, 0.136, 0.550, 0.764, 0.135]]),          // C: front leg from the lower longeron (x, y, z) to the axle (x, y, z), drawn as a streamlined strut of 0.135 m chord (T6); y at the axle extrapolated from the front view
        (name: "gear_rear_leg", rows: [[-0.430, 0.430, 0.230, 0.131, 0.550, 0.764]]),                 // C: rear leg from its exit of the belly (x, y, z) to the axle (T6); the parallel member 0.17 m aft (axle guide or strut) is left out until a photograph settles it
        (name: "skid_foot", rows: [[-4.200, -0.240]]),                                           // C: x and z of the foot of the tail skid on the fuselage (T6)
        (name: "wires", rows: [[0.0045, 0.0035, 0.0030, 0.050]]),                                // C: diameters of the flying, landing and incidence wires (aircraft.ron, drag of the wires: 8 flying wires of 4.5 mm doubled in tandem, 4 landing of 3.5 mm, 4 incidence of 3 mm); E: 0.05 m between the tandem flying wires
        (name: "aileron_linkage", rows: [[-0.80, 2.95, -0.92, 0.015]]),                           // E: x of the bellcrank on the lower plane, y beside the outer struts, x of the aileron's horn, rod of 15 mm (aircraft.ron, drag of the linkage; S48: outside linkage)
        (name: "ribs", rows: [[0.19, 0.015]]),                                                    // E: rib pitch of the S.XI (190 mm, spad7-aspect.md § 3, ESTIMÉ for the S.VII) and depth of the fabric's scallop between ribs at the trailing edge wire (C: scalloped trailing edge, § 3)
        (name: "windscreen", rows: [[-0.80, 0.15, 0.17, 30.0]]),                                  // E: x of its foot ahead of the cockpit opening, half-width, height and rake back in degrees (a glass screen, Hall and Bordeaux, spad7-aspect.md § 9; not drawn)
        (name: "vickers", rows: [[0.11, 0.60, 0.45, 0.10, 0.13]]),                                // E: jacket diameter and length, receiver length, width and height of the Vickers on the cowl (the muzzle of gun_muzzles_m at its front)
        (name: "tail_bracing", rows: [[-4.35, 0.75, -1.05, -0.32]]),                              // E: x of the bracing wires, y of their fitting on the tailplane, z of their ends on the fin and at the sternpost foot (aircraft.ron: 4 bracing wires of 0.8 m)
        (name: "cockpit_opening", rows: [
        //! C: half-width of the cockpit opening in the top view, seen through the cut-out (T7): an oval from x −1.35 to −0.85
            [-1.350, 0.000], [-1.300, 0.220], [-1.250, 0.330], [-1.200, 0.355], [-1.150, 0.360], [-1.100, 0.370], [-1.050, 0.377], [-0.950, 0.355], [-0.900, 0.260], [-0.850, 0.000],
        ]),
        (name: "cockpit_edge", rows: [
        //! C: z of the edge of the cockpit opening in the side view (T7): the rear rim (z −1.02), the elbow cut-out down to the upper longeron (−0.74) and the front edge rising to the top of the cowl
            [-1.500, -1.000], [-1.450, -1.019], [-1.400, -1.019], [-1.375, -1.006], [-1.350, -0.927], [-1.325, -0.850], [-1.300, -0.795], [-1.275, -0.784], [-1.250, -0.750], [-1.200, -0.742], [-1.150, -0.736], [-1.100, -0.736], [-1.050, -0.744], [-1.000, -0.784], [-0.950, -0.803], [-0.900, -0.836], [-0.850, -0.878], [-0.800, -0.918], [-0.750, -0.962], [-0.725, -0.975],
