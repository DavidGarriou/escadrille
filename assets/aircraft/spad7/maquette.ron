// Provisional 3D model of the SPAD S.VII C.1: what a box-and-plate model needs beyond
// aircraft.ron (plan docs/plans/modele-3d-provisoire.md). Body axes from the datum of
// aircraft.ron (x forward, y right, z down), metres. Built by `just mockup spad7`.
// No drawing of the S.VII was read (spad7.md § 2.5): the fuselage is an estimate, to be
// replaced if request D4 (docs/recherche/demandes.md) brings the factory drawings.
Mockup(
    fuselage: [
        //! E: rectangular sections, width 0.80 m as the flight model (lower wing roots), « exceptionally deep » (S48); side area 4.14 m² and plan area 3.09 m² against 4.50 and 3.30 m² of the fuselage block of aircraft.ron (C: drawing, tail left out); tail post under the tailplane (z −0.70) and the bottom of the rudder (z −0.31)
        (x_m: 0.70, width: M(0.72), top_m: -0.74, bottom_m: -0.02),
        (x_m: 0.30, width: M(0.80), top_m: -0.80, bottom_m: 0.05),
        (x_m: -1.20, width: M(0.80), top_m: -0.85, bottom_m: 0.15),
        (x_m: -2.60, width: M(0.55), top_m: -0.78, bottom_m: -0.02),
        (x_m: -4.30, width: M(0.15), top_m: -0.72, bottom_m: -0.30),
        (x_m: -4.80, width: M(0.04), top_m: -0.70, bottom_m: -0.31),
    ],
    wheels: (
        centre_m: (0.12, 0.76, 0.78),                                // E: as the wheel drag items of aircraft.ron; S: track 5 ft (S48)
        diameter: Mm(700.0),                                         // E: 700 × 75, as aircraft.ron (« 700 × 7… » on the S.XI drawing, S49)
        width: Mm(75.0),                                             // E: as the diameter
    ),
    skid_m: (-4.30, 0.0, 0.05),                                      // E: tail skid of aircraft.ron (x −4.30), tip 0.15 m below its drag centre
    struts: [
        (x_m: -0.40, y_m: 3.00),                                     // C: outer struts of aircraft.ron, y read on the front view
        (x_m: -0.40, y_m: 1.70),                                     // C: intermediate struts of aircraft.ron (S16)
    ],
    pilot_eye_m: (-1.05, 0.0, -1.10),                                // E: 0.10 m ahead of the head's centre (drag item of aircraft.ron)
    gun_muzzles_m: [
        (0.45, 0.0, -0.95),                                          // E: Vickers on the cowling (drag item of aircraft.ron at x −0.05), barrel about 1.1 m
    ],
    accepted_deviations: [
        //! Checks of `just test` (tools/asset_check) that this model fails, accepted by the player on 2026-10-26 (carnet)
        (
            check: "length",
            measured: M(6.264),                                      // C: hub (x 0.78) to the trailing edge of the rudder's root strip (x −5.48), against x −5.32 on the drawing
            reason: "the tail is the flight model's equivalent one, unswept with the area kept: its rudder ends 0.16 m behind the drawing's",
        ),                                                           // C: spad7-calculs.md § 3 (the drawing, scaled on an overall length of 6.10 m) and § 5 (unswept tail): above the tailplane, the equivalent fin has a root chord of 1.61 m on a straight quarter-chord line
        (
            check: "height",
            measured: M(2.355),                                      // C: at rest on the wheels and the skid (tail down 13.7°); 2.530 m in the flying attitude
            reason: "2.20 m cannot be the flying attitude, and at rest the drawing's undercarriage stands 2.30 to 2.36 m before its tyres and rubber cords settle under the weight (not modelled): drawing and tables disagree",
        ),                                                           // C: in flight, the fin top (z −1.40) and the propeller tip (z 0.82) alone span 2.22 m; at rest 2.304 m with the drawing's 0.58 m wheels, 2.355 m with 700 mm, the upper leading edge highest; 3 to 6 cm of static compression would give 2.26 to 2.33 m (aerodynamicist's review, 2026-10-25); spad7.md § 2.1 (2.12 to 2.35 m in the sources, attitude not given)
    ],
)
