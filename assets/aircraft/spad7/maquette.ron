            (0.899, -4.115, -4.925), (0.927, -4.127, -4.894), (0.955, -4.135, -4.890), (0.984, -4.146, -4.884),
            (1.012, -4.157, -4.882), (1.040, -4.165, -4.876), (1.068, -4.180, -4.870), (1.096, -4.192, -4.866),
